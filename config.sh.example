#!/usr/bin/env bash

# shellcheck disable=SC2034

########################################
# Linux Mint Setup configuration
########################################

#
# GIMP ecosystem repository
#
# Cloned and executed by the setup to install the
# complete GIMP ecosystem. Override to use a fork
# or a local clone.
#
GIMP_SETUP_REPO="https://github.com/diegochagas/gimp-setup.git"

#
# Homelab backup repository
#
# Cloned to ~/Projects/homelab-backup and configured with
# a systemd user timer that runs daily at 10:00 AM.
#
HOMELAB_BACKUP_REPO="https://github.com/diegochagas/homelab-backup.git"

#
# Git config includes
#
# Comma-separated list of Git config files added to the
# global configuration (include.path in ~/.gitconfig),
# e.g. files in a folder synced by Nextcloud that hold
# per-repository settings such as extra push URLs. A file
# that does not exist yet is picked up by Git once it
# appears. Use ~ for the home directory.
#
# Leave empty to skip the Git config includes step.
#
GIT_CONFIG_INCLUDES=""

#
# Installer and release URLs
#
# Override these if an upstream project moves its release assets,
# install script, or API endpoint.
#
SUBLIME_APT_GPG_URL="https://download.sublimetext.com/sublimehq-pub.gpg"
SUBLIME_APT_REPOSITORY="deb https://download.sublimetext.com/ apt/stable/"
REMOTE_MOUSE_ZIP_URL="https://www.remotemouse.net/downloads/linux/RemoteMouse_x86_64.zip"
BALENA_ETCHER_RELEASES_API_URL="https://api.github.com/repos/balena-io/etcher/releases/latest"
IMMICH_GO_RELEASES_API_URL="https://api.github.com/repos/simulot/immich-go/releases/latest"
LOCALSEND_RELEASES_API_URL="https://api.github.com/repos/localsend/localsend/releases/latest"
ZAPFAST_RELEASES_API_URL="https://api.github.com/repos/crmne/zapfast/releases/latest"
SCRCPY_GUI_RELEASES_API_URL="https://api.github.com/repos/SimonAKing/scrcpy-gui/releases/latest"
APP_MANAGER_RELEASES_API_URL="https://api.github.com/repos/kem-a/AppManager/releases/latest"
WATTAGE_NIGHTLY_BASE_URL="https://nightly.link/v81d/wattage/workflows/build-appimage/main"
WINBOAT_APPIMAGE_URL="https://github.com/TibixDev/winboat/releases/download/v0.9.0/winboat-0.9.0-x86_64.AppImage"
BLENDER_VERSION="4.2.3"
BLENDER_TARBALL_URL="https://download.blender.org/release/Blender4.2/blender-4.2.3-linux-x64.tar.xz"
TAILSCALE_INSTALL_URL="https://tailscale.com/install.sh"
CLAUDE_CODE_INSTALL_URL="https://claude.ai/install.sh"
CLAUDE_DESKTOP_DEB_URL="https://claude.ai/api/desktop/linux/x64/deb/latest/redirect"
DISCORD_DEB_URL="https://discord.com/api/download?platform=linux&format=deb"
OLLAMA_INSTALL_URL="https://ollama.com/install.sh"
GOOSE_CLI_INSTALL_URL="https://github.com/block/goose/releases/download/stable/download_cli.sh"
GOOSE_RELEASES_API_URL="https://api.github.com/repos/block/goose/releases/latest"

#
# Ollama models directory
#
# Where Ollama stores its models (tens of GB), e.g. a
# directory on a larger data disk. It is created and
# owned by the ollama service user.
#
# Leave empty to use Ollama's default location.
#
OLLAMA_MODELS_DIR=""

#
# Goose local model
#
# GOOSE_OLLAMA_BASE_MODEL is pulled from the Ollama
# library and copied as GOOSE_OLLAMA_MODEL with a
# GOOSE_OLLAMA_CONTEXT-token context, which Goose uses.
# The default base model needs about 24 GB of RAM (GPU
# memory counts toward it); on smaller machines use e.g.
# qwen3:8b with a 16384 context.
#
GOOSE_OLLAMA_BASE_MODEL="qwen3:30b-a3b-instruct-2507-q4_K_M"
GOOSE_OLLAMA_MODEL="qwen3-instruct-32k"
GOOSE_OLLAMA_CONTEXT="32768"

#
# SearXNG instance for Goose web search
#
# Base URL of a SearXNG instance with the JSON output
# format enabled, used by Goose's SearXNG extension.
#
# Leave empty to skip the SearXNG extension.
#
GOOSE_SEARXNG_URL=""

#
# ComfyUI, the local AI models behind GIMP's AI tools
#
# Installed by the GIMP setup (see GIMP_SETUP_REPO above), which
# reads these three values from here. COMFYUI_DIR is where
# ComfyUI, its Python environment and its models are installed,
# e.g. a directory on a larger data disk: the models are tens of
# GB and it wants about 45 GB free. Needs an NVIDIA GPU with its
# driver installed (a 6 GB card is enough; what does not fit is
# kept in RAM).
#
# Leave COMFYUI_DIR empty to skip ComfyUI entirely.
#
COMFYUI_DIR=""

#
# Which model sets to download, comma separated:
#
#   qwen  - Qwen-Image-Edit-2511, ~22 GB. Best quality;
#           what comic-skills uses to erase text over art.
#   klein - FLUX.2 klein 4B, ~12 GB. Faster, lower quality;
#           the only one that generates images from text.
#
# Both by default. Leave empty to install ComfyUI without
# any model.
#
COMFYUI_MODEL_SETS="qwen,klein"

#
# Port the ComfyUI user service listens on (127.0.0.1 only).
#
COMFYUI_PORT="8188"

#
# RPG Maker library
#
# Directory that contains the RPG Maker games library:
# one subfolder per game plus the shared RTP assets in
# RTP/2000 and RTP/2003 subfolders, e.g. a folder
# synced by Nextcloud. EasyRPG Player is granted
# access to the library and the RTP is copied to its
# default search path together with a GM soundfont for
# MIDI music. Open the games with EasyRPG's built-in
# game browser; saves are written inside each game
# folder, so progress stays synced across machines.
#
# Leave empty to skip the EasyRPG Player configuration
# step.
#
RPG_MAKER_LIBRARY_DIR=""
